# Use keys from the same Clerk application as the backend.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Browser requests go directly to the Express backend.
NEXT_PUBLIC_BACKEND_URL=http://localhost:5000

# Optional: required only for Next.js server-side auth and the /api/me proxy.
# Browser sign-in does not need this; keep the main secret in backend/.env.
CLERK_SECRET_KEY=

# Optional server-side proxy origin. Never expose the Clerk secret in NEXT_PUBLIC_*.
BACKEND_URL=http://localhost:5000
