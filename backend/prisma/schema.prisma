generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}


model User {
  id         String     @id @default(uuid())
  email      String     @unique   
  createdAt  DateTime   @default(now()) 
  apiKey     apiKey[]
}

model apiKey {
  id          String    @id @default(uuid())
  hashedKey   String    @unique
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
    
  createdAt   DateTime   @default(now())

  @@index([userId])
}